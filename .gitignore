# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# uploaded videos (keep directory structure but ignore video files)
public/videos/*.mp4
public/videos/*.webm
public/videos/*.ogg
public/videos/*.mov
public/videos/*.MOV
public/videos/*.avi

# uploaded product images (keep directory structure but ignore image files)
# public/images/products/*.jpg
# public/images/products/*.jpeg
# public/images/products/*.png
# public/images/products/*.gif
# public/images/products/*.webp
# public/images/products/*.svg

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
